# Razorpay — copy to functions/.env for local emulator use.
# For production, prefer Firebase Secret Manager.

# Placeholder — replace with your Razorpay Dashboard → API Keys values
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Optional: pre-created Razorpay plan ids (₹99 monthly / ₹999 yearly)
# RAZORPAY_PLAN_MONTHLY_ID=plan_xxxxxxxx
# RAZORPAY_PLAN_YEARLY_ID=plan_yyyyyyyy

# Legacy paid-subscription webhook (Bearer). Prefer razorpayWebhook.
# REFERRAL_WEBHOOK_SECRET=YOUR_LEGACY_WEBHOOK_SECRET
